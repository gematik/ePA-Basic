                <mxCell id="kaKPPBhv6QyS-EkI_fyc-150" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;strokeWidth=1;" value="&lt;span style=&quot;background-color: transparent; font-size: 14px;&quot;&gt;&lt;b&gt;&amp;nbsp; Abkürzungen:&lt;/b&gt;&lt;br&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;background-color: transparent; font-size: 14px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;TI - Telematikinfrastruktur&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;background-color: transparent; font-size: 14px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;IDP - Identitiy Provider&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;background-color: transparent; font-size: 14px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;SigD - Content Signaturdienst für Versicherte&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;background-color: transparent; font-size: 14px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;FdV - Frontend des Versicherten&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;background-color: transparent; font-size: 14px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;eGK - Elektronische Gesundheitskarte&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;background-color: transparent; font-size: 14px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;VZD - Verzeichnisdienst&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;background-color: transparent; font-size: 14px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;eH-KT - eHealth-Kartenterminal&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;background-color: transparent; font-size: 14px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;SM-B - Institutionskarte&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;background-color: transparent; font-size: 14px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;PS - Primärsystem&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;background-color: transparent; font-size: 14px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;WANDA - Weitere Anwendungen ...&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;background-color: transparent; font-size: 14px;&quot;&gt;&amp;nbsp; &